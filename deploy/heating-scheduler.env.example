# Copy to /etc/heating-scheduler/env (chmod 600, owned by root).
# Any appsettings value can be overridden here using Section__Key syntax.
# Write values as plain text: no quotes or backslash escapes.
Wavin__Email=you@example.com
Wavin__Password=change-me

# Email notifications (optional). For Gmail use an app password.
# Email__Enabled=true
# Email__To__0=you@example.com
# Email__Username=sender@gmail.com
# Email__Password=app-password

# Examples of other overrides:
# Octopus__RegionCode=H
# Schedule__MinOnMinutes=60
# Schedule__SafetyMargin=0.2
# Heating__OnTemperature=22.5
# Heating__OffTemperature=16
# Schedule__MinTemperature=20.5
# Schedule__Rooms__0=AT3 Lobby
